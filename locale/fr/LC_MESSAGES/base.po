msgstr "Cela ressemble à un projet {0} : définir le builder = \"{0}\"."

#: src/app_release/cli.py:123
msgid "Configuration: destination {0!r} is not one of {1}."
msgstr "Configuration : la destination {0!r} ne fait pas partie de {1}."

#: src/app_release/cli.py:130
