#: src/app_release/cli.py:71
msgid ""
"Release an app: rebuild what is behind, stage the artifacts, tag the build's"
" commit and publish."
msgstr ""
"Выпустить приложение: перестроить зависимое, подготовить артефакты, пометить"
" коммит сборки и опубликовать."

#: src/app_release/cli.py:73
msgid "the app's checkout (default: the current directory)"
msgstr "checkout приложения (по умолчанию: текущий каталог)"

#: src/app_release/cli.py:76
msgid "build system, instead of the configured one (default: nuitka)"
msgstr "система сборки, вместо настроенной (по умолчанию: nuitka)"

#: src/app_release/cli.py:78
msgid ""
"where to publish, instead of the configured ones (default: github); "
"repeatable"
msgstr ""
"Куда публиковать вместо настроенных (по умолчанию: github); повторяемо"

#: src/app_release/cli.py:80
msgid ""
"what runs the build: the Python interpreter (nuitka), a rustup toolchain "
"(cargo)"
msgstr ""
"что запускает сборку: интерпретатор Python (nuitka), набор инструментов "
"rustup (cargo)"

#: src/app_release/cli.py:83
msgid ""
"raise this part of the version and commit it once the current one is tagged"
msgstr ""
"Повышайте эту часть версии и сделайте commit, когда текущая будет помечена "
"тегом"

#: src/app_release/cli.py:84
msgid "suffix for a build variant, e.g. cuda"
msgstr "суффикс для варианта сборки, например cuda"

#: src/app_release/cli.py:85
msgid "package only these products (names without extension)"
msgstr "Упаковать только эти продукты (имена без расширения)"

#: src/app_release/cli.py:86
msgid "package the artifacts as they are, without rebuilding"
msgstr "Упакуйте артефакты как есть, без пересборки"

#: src/app_release/cli.py:88
msgid "the build record the artifacts were built with, to put back in place"
msgstr ""
"Запись сборки, с которой были построены артефакты, чтобы вернуть её на место"

#: src/app_release/cli.py:90
msgid "move tag v<version> to the build's commit when it points elsewhere"
msgstr ""
"Переместить тег v<version> к коммиту сборки, когда он указывает в другое "
"место"

#: src/app_release/cli.py:91
msgid "package even when checks fail"
msgstr "упаковать даже если проверки не прошли"

#: src/app_release/cli.py:92
msgid "release notes file to use instead of the generated one"
msgstr ""
"файл примечаний к выпуску, который следует использовать вместо "
"сгенерированного"

#: src/app_release/cli.py:93
msgid "stage the assets and print the commands only"
msgstr "подготовить ресурсы и вывести только команды"

#: src/app_release/cli.py:94
msgid "publish the release instead of leaving a draft"
msgstr "Опубликовать релиз, а не оставлять его черновиком"

#: src/app_release/cli.py:95
msgid "git remote to push the tag to (default: origin)"
msgstr "git‑удалённый репозиторий для отправки тега (по умолчанию: origin)"

#: src/app_release/cli.py:96
msgid "approve the release notes and upload without asking first"
msgstr ""
"Одобрите примечания к релизу и загрузите их без предварительного запроса"

#: src/app_release/cli.py:98
msgid "also run the steps that cannot be undone without asking"
msgstr "также выполнить шаги, которые нельзя отменить без запроса"

#: src/app_release/cli.py:107
msgid "Configuration: builder {0!r} is not one of {1}."
msgstr "Конфигурация: конструктор {0!r} не является одним из {1}."

#: src/app_release/cli.py:112
msgid "{0} has no {1}, which builder {2!r} needs."
msgstr "{0} не имеет {1}, который нужен сборщику {2!r}."

#: src/app_release/cli.py:114
msgid "It looks like a {0} project: set builder = \"{0}\"."
msgstr "Похоже на проект {0}: установить builder = \"{0}\"."

#: src/app_release/cli.py:123
msgid "Configuration: destination {0!r} is not one of {1}."
msgstr "Конфигурация: пункт назначения {0!r} не является одним из {1}."

#: src/app_release/cli.py:130
msgid "yes"
msgstr "да"

#: src/app_release/cli.py:131
msgid "{0} [y/N] "
msgstr "{0} [y/N] "

#: src/app_release/cli.py:147
msgid "{0} is not a folder."
msgstr "{0} не является папкой."

#: src/app_release/cli.py:154
msgid ""
"app-release {0} on {1}: builder {2}, destinations {3}, configured in {4}"
msgstr ""
"app-release {0} на {1}: builder {2}, назначения {3}, сконфигурировано в {4}"

#: src/app_release/cli.py:157
msgid ""
"app-release {0} on {1}: builder {2}, destinations {3}, default configuration"
msgstr ""
"app-release {0} на {1}: сборщик {2}, назначения {3}, конфигурация по "
"умолчанию"

#: src/app_release/cli.py:160
msgid "Configuration: {0!r} is not a setting this version reads; a typo?"
msgstr ""
"Конфигурация: {0!r} не является параметром, который читает эта версия; "
"опечатка?"

#: src/app_release/cli.py:170
msgid "No artifact for: {0}"
msgstr "Нет артефакта для: {0}"

#: src/app_release/cli.py:173
msgid "No artifacts found for builder {0}; build first."
msgstr "Для builder {0} не найдено артефактов; сначала выполните сборку."

#: src/app_release/cli.py:175
msgid "--notes: {0} not found."
msgstr "--заметки: {0} не найдено."

#: src/app_release/cli.py:200
msgid "Nothing packaged; fix the errors above or pass --force."
msgstr "Ничего не упаковано; исправьте ошибки выше или используйте --force."

#: src/app_release/cli.py:203
msgid "Cannot tell which commit the build is from."
msgstr "Невозможно определить, из какого коммита сборка."

#: src/app_release/cli.py:207
msgid "Staging the assets in {0}"
msgstr "Подготовка ресурсов в {0}"

#: src/app_release/cli.py:216
msgid ""
"Keeping the edited release notes in {0}; delete the file to regenerate them."
msgstr ""
"Сохраняются отредактированные примечания к выпуску в {0}; удалите файл, "
"чтобы сгенерировать их заново."

#: src/app_release/cli.py:217 tests/test_cli.py:93
msgid "Staged in {0}; release notes: {1}"
msgstr "Подготовлено в {0}; примечания к выпуску: {1}"

#: src/app_release/cli.py:225
msgid ""
"To publish, from {0}, tag {1} as {2} (git tag -f, and git push --force for "
"the tag), push the branch with that commit and the tag, then:"
msgstr ""
"Чтобы опубликовать, из {0} пометьте {1} как {2} (git tag -f и git push "
"--force для тега), отправьте ветку с этим коммитом и тегом, затем:"

#: src/app_release/cli.py:228
msgid ""
"To publish, from {0}, tag {1} as {2}, push the branch with that commit and "
"the tag, then:"
msgstr ""
"Чтобы опубликовать, из {0}, пометьте {1} как {2}, сделайте push ветки с этим"
" коммитом и тегом, затем:"

#: src/app_release/cli.py:237
msgid "{0} is already published with these assets."
msgstr "{0} уже опубликован с этими ресурсами."

#: src/app_release/cli.py:242
msgid "In {0}:"
msgstr "В {0}:"

#: src/app_release/cli.py:247
msgid "Not run: pass --yes to upload without a terminal to confirm in."
msgstr ""
"Не выполнено: передайте --yes, чтобы загрузить без терминала для "
"подтверждения."

#: src/app_release/cli.py:248
msgid "Run these?"
msgstr "Запустить их?"

#: src/app_release/cli.py:249 src/app_release/cli.py:255
#: src/app_release/pipeline.py:292
msgid "Not run."
msgstr "Не выполнено."

#: src/app_release/cli.py:252
msgid ""
"Not run: steps for {0} cannot be undone; pass --yes-irreversible to run them"
" without a terminal."
msgstr ""
"Не выполнено: шаги для {0} нельзя отменить; укажите --yes-irreversible, "
"чтобы выполнить их без терминала."

#: src/app_release/cli.py:254
msgid "Steps for {0} cannot be undone. Go ahead?"
msgstr "Шаги для {0} нельзя отменить. Продолжить?"

#: src/app_release/cli.py:259
msgid ""
"Stopped: the command above failed. Running this again resumes from there."
msgstr ""
"Остановлено: команда выше завершилась с ошибкой. Повторный запуск продолжит "
"с этого места."

#: src/app_release/cli.py:261
msgid "Published {0}."
msgstr "Опубликовано {0}."

#: src/app_release/cli.py:263
msgid ""
"{0} is a draft release; publish it on GitHub, or run this again with "
"--publish."
msgstr ""
"{0} — черновик релиза; опубликуйте его на GitHub или запустите снова с "
"--publish."

#: src/app_release/cli.py:268
msgid ""
"nuitka-release is now app-release: run app-release with the same arguments "
"(app-release --memory-wait-plugin for the plugin's path)."
msgstr ""
"nuitka-release теперь называется app-release: запустите app-release с теми "
"же аргументами (app-release --memory-wait-plugin для пути плагина)."

#: src/app_release/cli.py:282
msgid "Stopped after {0}"
msgstr "Остановлено после {0}"

#: src/app_release/cli.py:286
msgid "Interrupted after {0}"
msgstr "Прервано после {0}"

#: src/app_release/cli.py:289
msgid "Failed after {0}"
msgstr "Не удалось после {0}"

#: src/app_release/cli.py:291
msgid "Done in {0}"
msgstr "Выполнено за {0}"

#: src/app_release/config.py:40
msgid "Cannot read {0}: {1}"
msgstr "Не удаётся прочитать {0}: {1}"

#: src/app_release/config.py:52
msgid "Both {0} and [tool.release] in {1} configure the release; keep one."
msgstr "И {0}, и [tool.release] в {1} настраивают релиз; оставьте один."

#: src/app_release/log.py:144
msgid "Deleted the old run log {0}"
msgstr "Старый журнал выполнения {0} удалён"

#: src/app_release/log.py:166 tests/test_log_and_platforms.py:61
msgid "Log: {0}"
msgstr "Журнал: {0}"

#: src/app_release/log.py:175
msgid "Could not copy the log into {0}: {1}"
msgstr "Не удалось скопировать журнал в {0}: {1}"

#: src/app_release/log.py:205
msgid "Could not delete the old run log {0}: {1}"
msgstr "Не удалось удалить старый журнал выполнения {0}: {1}"

#: src/app_release/log.py:253 tests/test_log_and_platforms.py:113
msgid "{0}h {1:02d}m {2:02d}s"
msgstr "{0}ч {1:02d}м {2:02d}с"

#: src/app_release/log.py:255 tests/test_log_and_platforms.py:114
msgid "{0}m {1:02d}s"
msgstr "{0} мин {1:02d} с"

#: src/app_release/log.py:256 tests/test_log_and_platforms.py:115
msgid "{0}s"
msgstr "{0}s"

#: src/app_release/log.py:263 tests/test_log_and_platforms.py:17
msgid "{0}..."
msgstr "{0}..."

#: src/app_release/log.py:267 tests/test_log_and_platforms.py:27
msgid "{0} failed after {1}"
msgstr "{0} завершился с ошибкой после {1}"

#: src/app_release/log.py:269 tests/test_log_and_platforms.py:18
msgid "{0} done in {1}"
msgstr "{0} выполнено за {1}"

#: src/app_release/pipeline.py:26
msgid "it is older than the checkout's last commit"
msgstr "это старее последнего коммита в checkout"

#: src/app_release/pipeline.py:29
msgid "it predates the last build, so its source is unknown"
msgstr "Он предшествует последней сборке, поэтому его источник неизвестен"

#: src/app_release/pipeline.py:33
msgid "it was built from {0}, the checkout is at {1}"
msgstr "это было построено из {0}, чек‑аут находится по адресу {1}"

#: src/app_release/pipeline.py:34
msgid "an unknown commit"
msgstr "неизвестный коммит"

#: src/app_release/pipeline.py:37 tests/test_pipeline.py:109
msgid ""
"it was built from {0}, which has the checkout's files but is not in its "
"history (rewritten since), so it cannot be tagged"
msgstr ""
"Он был построен из {0}, у которого есть файлы чек‑аута, но их нет в истории "
"(с тех пор переписано), поэтому его нельзя пометить"

#: src/app_release/pipeline.py:40
msgid "it was built with uncommitted changes"
msgstr "было собрано с незакоммиченными изменениями"

#: src/app_release/pipeline.py:42
msgid "it is version {0}, the checkout says {1}"
msgstr "это версия {0}, касса сообщает {1}"

#: src/app_release/pipeline.py:70
msgid ""
"git cannot tell which commit the checkout is at; build yourself and pass "
"--no-build."
msgstr ""
"git не может определить, на каком коммите находится checkout; соберите сами "
"и передайте --no-build."

#: src/app_release/pipeline.py:75
msgid "{0} is behind: {1}."
msgstr "{0} отстает: {1}."

#: src/app_release/pipeline.py:78
msgid ""
"Every artifact was built from {0} or a commit with its files; nothing to "
"rebuild."
msgstr ""
"Каждый артефакт был построен из {0} или коммита с его файлами; ничего "
"перестраивать."

#: src/app_release/pipeline.py:81
msgid ""
"Tracked files have uncommitted changes; commit or stash them, so the build "
"matches a commit, and run this again."
msgstr ""
"Отслеживаемые файлы содержат незакоммиченные изменения; сделайте commit или "
"stash, чтобы сборка соответствовала коммиту, и запустите это снова."

#: src/app_release/pipeline.py:95
msgid "Version {0!r} is not up to four dot-separated numbers."
msgstr "Версия {0!r} не состоит из до четырёх чисел, разделённых точками."

#: src/app_release/pipeline.py:99
msgid "No build record: cannot check what the artifacts were built from."
msgstr ""
"Отсутствует запись сборки: невозможно определить, из чего были построены "
"артефакты."

#: src/app_release/pipeline.py:103
msgid "The build is version {0}, the checkout says {1}."
msgstr "Сборка имеет версию {0}, в checkout указано {1}."

#: src/app_release/pipeline.py:105
msgid "The build was made with uncommitted changes; commit them and rebuild."
msgstr ""
"Сборка была выполнена с незакоммиченными изменениями; закоммитьте их и "
"пересоберите."

#: src/app_release/pipeline.py:107
msgid "The build could not tell whether it had uncommitted changes."
msgstr "Сборка не смогла определить, есть ли неподтверждённые изменения."

#: src/app_release/pipeline.py:110
msgid "The build is from commit {0}, the checkout is at {1}."
msgstr "Сборка из коммита {0}, checkout находится в {1}."

#: src/app_release/pipeline.py:113
msgid "Packaging it as it is (--no-build)."
msgstr "Упаковываем как есть (--no-build)."

#: src/app_release/pipeline.py:117 tests/test_pipeline.py:163
msgid ""
"The build is from commit {0}, which has the checkout's files but is not in "
"its history (rewritten since the build), so it cannot be tagged; rebuild it."
msgstr ""
"Сборка создана из коммита {0}, который имеет файлы checkout, но отсутствует "
"в его истории (перезаписан после сборки), поэтому её нельзя пометить; "
"выполните пересборку."

#: src/app_release/pipeline.py:121
msgid ""
"The build embeds the text of its checkout path, {0} (not the folder's "
"contents), where anyone who downloads it can read it."
msgstr ""
"Сборка встраивает текст своего пути checkout, {0} (не содержимое папки), и "
"любой, кто его загрузит, может его прочитать."

#: src/app_release/pipeline.py:126
msgid "{0} {1} is a {2} build; consider --variant {2}."
msgstr "{0} {1} — это сборка {2}; рассмотрите --variant {2}."

#: src/app_release/pipeline.py:130
msgid ""
"{0} predates the last build; rebuild it, or leave it out with --products."
msgstr ""
"{0} предшествует последнему сбору; пересоберите его или исключите его с "
"помощью --products."

#: src/app_release/pipeline.py:136
msgid "Tag {0} points at {1}; --retag moves it to {2}."
msgstr "Тег {0} указывает на {1}; --retag перемещает его в {2}."

#: src/app_release/pipeline.py:138
msgid "Tag {0} points at {1}, not the build's commit {2}; --retag moves it."
msgstr ""
"Тег {0} указывает на {1}, а не на коммит сборки {2}; --retag перемещает его."

#: src/app_release/pipeline.py:143 tests/test_pipeline.py:220
msgid ""
"{0} is {1:.0f} GiB or larger, more than a destination accepts as an asset."
msgstr ""
"{0} объёмом {1:.0f} GiB или больше, превышает предел приема назначения как "
"ресурса."

#: src/app_release/pipeline.py:173
msgid ""
"Two artifacts would both be staged as {0}; give them distinct product names."
msgstr ""
"Два артефакта будут оба размещены как {0}; присвойте им разные названия "
"продуктов."

#: src/app_release/pipeline.py:181
msgid "Staging {0} -> {1}"
msgstr "Подготовка {0} -> {1}"

#: src/app_release/pipeline.py:274
msgid "Cannot start the editor {0!r}: {1}"
msgstr "Не удалось запустить редактор {0!r}: {1}"

#: src/app_release/pipeline.py:277
msgid "The editor {0!r} exited with code {1}."
msgstr "Редактор {0!r} завершился с кодом {1}."

#: src/app_release/pipeline.py:287
msgid "approve"
msgstr "Одобрить"

#: src/app_release/pipeline.py:287
msgid "edit"
msgstr "Редактировать"

#: src/app_release/pipeline.py:288
msgid "Release notes: [a]pprove, [e]dit, or abort? [a/e/N] "
msgstr ""
"Примечания к выпуску: [a]подтвердить, [e]редактировать или отменить? [a/e/N]"
" "

#: src/app_release/pipeline.py:293
msgid ""
"Waiting for the editor to close (an editor that returns at once, such as "
"`code`, needs its wait option, e.g. EDITOR=\"code --wait\")."
msgstr ""
"Ожидание закрытия редактора (редактор, который сразу возвращается, например "
"`code`, требует опцию ожидания, например EDITOR=\\\"code --wait\\\")."

#: src/app_release/record.py:34 tests/test_record.py:48
msgid ""
"{0} has build record schema {1!r}; app-release {2} reads up to {3}. Update "
"app-release."
msgstr ""
"{0} имеет схему записи сборки {1!r}; app-release {2} читает до {3}. Обновите"
" app-release."

#: src/app_release/record.py:70
msgid "--build-info: cannot read {0}: {1}"
msgstr "--build-info: невозможно прочитать {0}: {1}"

#: src/app_release/record.py:73
msgid "--build-info: {0} names no version and commit; is it a build record?"
msgstr "--build-info: {0} не содержит версию и коммит; это запись сборки?"

#: src/app_release/record.py:79
msgid "Restored {0} from {1}: version {2}, build {3}, commit {4}."
msgstr "Восстановлен {0} из {1}: версия {2}, сборка {3}, коммит {4}."

#: src/app_release/record.py:114
msgid "Wrote the build record {0}."
msgstr "Записана запись сборки {0}."

#: src/app_release/vcs.py:56
msgid "Cannot reach the git remote {0}."
msgstr "Не удалось подключиться к git‑remote {0}."

#: src/app_release/vcs.py:66
msgid "HEAD is not on a branch; push the branch with {0} to {1} yourself."
msgstr ""
"HEAD не находится на ветке; отправьте ветку с {0} в {1} самостоятельно."

#: src/app_release/versions.py:52
msgid "No version found: {0} does not exist."
msgstr "Версия не найдена: {0} не существует."

#: src/app_release/versions.py:75
msgid "Version pattern {0!r} must have exactly one group, the version."
msgstr "Шаблон версии {0!r} должен содержать ровно одну группу — версию."

#: src/app_release/versions.py:80
msgid "No version found in {0} by {1!r}."
msgstr "Версия не найдена в {0} от {1!r}."

#: src/app_release/versions.py:134
msgid "No version found: {0} has no {1}."
msgstr "Не найдено версии: у {0} нет {1}."

#: src/app_release/versions.py:137
msgid "{0}: {1} is not a string."
msgstr "{0}: {1} не является строкой."

#: src/app_release/versions.py:153
msgid ""
"Cannot find the line of {0} in {1} to change; set the version yourself."
msgstr "Не найдено строка {0} в {1} для изменения; установите версию вручную."

#: src/app_release/versions.py:163
msgid "JSON version key {0!r}: only a top-level key is supported."
msgstr "Ключ версии JSON {0!r}: поддерживается только ключ верхнего уровня."

#: src/app_release/versions.py:171
msgid "No version found: {0} has no string {1!r}."
msgstr "Версия не найдена: у {0} нет строки {1!r}."

#: src/app_release/versions.py:194
msgid ""
"Configuration: cannot read version = {0!r}; give a file, or one of pattern, "
