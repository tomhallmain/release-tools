msgstr "Parece un proyecto {0}: establecer constructor = \"{0}\"."

#: src/app_release/cli.py:123
msgid "Configuration: destination {0!r} is not one of {1}."
msgstr "Configuración: el destino {0!r} no es uno de {1}."

#: src/app_release/cli.py:130
msgid "yes"
msgstr "sí"

