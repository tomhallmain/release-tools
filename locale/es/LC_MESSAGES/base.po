#: src/app_release/cli.py:71
msgid ""
"Release an app: rebuild what is behind, stage the artifacts, tag the build's"
" commit and publish."
msgstr ""
"Publicar una app: recompilar lo subyacente, preparar los artefactos, "
"etiquetar el commit de la compilación y publicar."

#: src/app_release/cli.py:73
msgid "the app's checkout (default: the current directory)"
msgstr "el checkout de la aplicación (predeterminado: el directorio actual)"

#: src/app_release/cli.py:76
msgid "build system, instead of the configured one (default: nuitka)"
msgstr ""
"sistema de compilación, en lugar del configurado (predeterminado: nuitka)"

#: src/app_release/cli.py:78
msgid ""
"where to publish, instead of the configured ones (default: github); "
"repeatable"
msgstr ""
"Dónde publicar, en lugar de los configurados (por defecto: github); "
"repetible"

#: src/app_release/cli.py:80
msgid ""
"what runs the build: the Python interpreter (nuitka), a rustup toolchain "
"(cargo)"
msgstr ""
"qué ejecuta la compilación: el intérprete de Python (nuitka), una cadena de "
"herramientas rustup (cargo)"

#: src/app_release/cli.py:83
msgid ""
"raise this part of the version and commit it once the current one is tagged"
msgstr ""
"Incrementa esta parte de la versión y haz commit cuando la actual esté "
"etiquetada"

#: src/app_release/cli.py:84
msgid "suffix for a build variant, e.g. cuda"
msgstr "sufijo de una variante de compilación, p. ej. cuda"

#: src/app_release/cli.py:85
msgid "package only these products (names without extension)"
msgstr "Empaquetar solo estos productos (nombres sin extensión)"

#: src/app_release/cli.py:86
msgid "package the artifacts as they are, without rebuilding"
msgstr "Empaquete los artefactos tal como están, sin recompilarlos"

#: src/app_release/cli.py:88
msgid "the build record the artifacts were built with, to put back in place"
msgstr ""
"El registro de compilación con el que se construyeron los artefactos, para "
"volver a colocarlo"

#: src/app_release/cli.py:90
msgid "move tag v<version> to the build's commit when it points elsewhere"
msgstr ""
"Mover la etiqueta v<version> al commit de la compilación cuando apunta a "
"otro lado"

#: src/app_release/cli.py:91
msgid "package even when checks fail"
msgstr "empaquetar incluso si las comprobaciones fallan"

#: src/app_release/cli.py:92
msgid "release notes file to use instead of the generated one"
msgstr "archivo de notas de la versión para usar en lugar del generado"

#: src/app_release/cli.py:93
msgid "stage the assets and print the commands only"
msgstr "preparar los recursos e imprimir solo los comandos"

#: src/app_release/cli.py:94
msgid "publish the release instead of leaving a draft"
msgstr "Publicar el release en lugar de dejarlo como borrador"

#: src/app_release/cli.py:95
msgid "git remote to push the tag to (default: origin)"
msgstr "remoto de git al que enviar la etiqueta (por defecto: origin)"

#: src/app_release/cli.py:96
msgid "approve the release notes and upload without asking first"
msgstr "Aprueba las notas de la versión y súbelas sin preguntar primero"

#: src/app_release/cli.py:98
msgid "also run the steps that cannot be undone without asking"
msgstr "también ejecutar los pasos que no pueden deshacerse sin preguntar"

#: src/app_release/cli.py:107
